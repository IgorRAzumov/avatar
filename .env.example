# Server
SERVER_ADDR=:8080
BASE_URL=http://localhost:8080
MAX_UPLOAD_MB=10

# PostgreSQL (migrations are embedded in the binary and run automatically)
DATABASE_DSN=postgres://avatar:avatar@localhost:5432/avatar?sslmode=disable

# MinIO / S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false
S3_REGION=us-east-1

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=false
RABBITMQ_EXCHANGE=avatars.exchange
