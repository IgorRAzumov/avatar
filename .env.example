# Server
SERVER_ADDR=:8080
# Prometheus scrape endpoint lives on its own port and is never exposed publicly
METRICS_ADDR=:9090
BASE_URL=http://localhost:8080
MAX_UPLOAD_MB=10
# Networks of reverse proxies whose X-Forwarded-For may be trusted (comma-separated).
# Empty: the client address is taken from the connection, headers are ignored.
TRUSTED_PROXY_CIDRS=

# PostgreSQL (migrations are embedded in the binary)
# POSTGRES_AUTO_MIGRATE=true: the process migrates on startup (local, docker compose)
# POSTGRES_AUTO_MIGRATE=false: migrations are owned by ./cmd/migrate (Helm hook in Kubernetes)
# Docker: postgres://avatar:avatar@localhost:5432/avatar?sslmode=disable
# macOS Homebrew: postgres://YOUR_OS_USER@localhost:5432/avatar?sslmode=disable
DATABASE_DSN=postgres://avatar:avatar@localhost:5432/avatar?sslmode=disable
POSTGRES_AUTO_MIGRATE=true

# MinIO / S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false
S3_REGION=us-east-1

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_ENABLED=false
RABBITMQ_EXCHANGE=avatars.exchange

# Rate limiting (requests per second per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=50

# Observability (traces and logs are pushed over OTLP, metrics are pulled from /metrics)
OTEL_SERVICE_NAME=avatar-service
OTEL_SERVICE_VERSION=1.0.0
OTEL_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACING_ENABLED=true
# Sampled share of traces: 1 keeps all, 0.1 keeps every tenth
OTEL_TRACE_SAMPLE_RATIO=1
OTEL_LOGS_ENABLED=true
OTEL_METRICS_ENABLED=true
LOG_LEVEL=info

# Worker process (go run ./cmd/worker)
# OTEL_SERVICE_NAME=avatar-service-worker
